# Copy to .env (never commit .env)
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SITE_ADDRESS=:80            # LAN demo. Cloud: your domain, e.g. rehab.example.com (automatic HTTPS)
COOKIE_SECURE=false         # true when served over HTTPS
STUB_MODE=true              # wave 0 only: routers serve demo fixtures. Becomes false once the real routers are merged.
